# AKShare API 配置文件示例
# 复制此文件为 .env 并修改相关配置

# ========== 基础配置 ==========
# 运行环境: development, production
ENVIRONMENT=development

# 服务监听地址和端口
HOST=0.0.0.0
PORT=8000

# 生产环境 Worker 数量
WORKERS=4


# ========== Token 认证配置 ==========
# API Token 列表,使用逗号分隔多个 token
# 生产环境请务必修改为安全的 token
API_TOKENS=your-secret-token-here,another-token-here

# Token 请求头名称
TOKEN_HEADER_NAME=X-API-Token


# ========== CORS 配置 ==========
# 允许的跨域来源,使用逗号分隔
# 开发环境可以使用 * 允许所有来源
# 生产环境建议指定具体的域名
CORS_ORIGINS=*


# ========== 可信主机配置 ==========
# 生产环境下允许的主机列表,使用逗号分隔
ALLOWED_HOSTS=*


# ========== 速率限制配置 ==========
# 是否启用速率限制
RATE_LIMIT_ENABLED=true

# 速率限制: 在指定秒数内允许的最大请求次数
RATE_LIMIT_TIMES=100
RATE_LIMIT_SECONDS=60


# ========== 缓存配置 ==========
# 是否启用缓存
CACHE_ENABLED=false

# 缓存过期时间(秒)
CACHE_EXPIRE_SECONDS=300


# ========== 日志配置 ==========
# 日志级别: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# 日志文件路径
LOG_FILE=logs/akshare_api.log


# ========== 数据返回配置 ==========
# 单次请求最大返回行数
MAX_ROWS=10000

